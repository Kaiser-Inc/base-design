        "@layer base": {
          "button:not(:disabled), [role=\"button\"]:not(:disabled)": {
            "cursor": "pointer"
          }
        },
        "@media (prefers-reduced-motion: reduce)": {
          "*, *::before, *::after": {
            "transition-property": "opacity, color, background-color, border-color, outline-color, fill, stroke, stroke-dashoffset !important",
            "--tw-enter-scale": "1 !important",
            "--tw-enter-translate-x": "0 !important",
            "--tw-enter-translate-y": "0 !important",
            "--tw-exit-scale": "1 !important",
            "--tw-exit-translate-x": "0 !important",
            "--tw-exit-translate-y": "0 !important"
          },
          "[data-starting-style], [data-ending-style]": {
            "--tw-scale-x": "100% !important",
            "--tw-scale-y": "100% !important",
            "--tw-scale-z": "100% !important",
            "transform": "none !important"
          }
